// Database and Backup Services Stopped En Masse
// Detects bulk service stops targeting databases, mail and backup agents. Ransomware does this to unlock files held open by those services so they can be encrypted too.
// techniques: T1489   severity: critical   status: stable
// validate: Atomic Red Team T1489
//   net stop MSSQLSERVER /y
//   net stop VeeamBackupSvc /y
// source: rules/impact/service-stop-before-encryption.yml  (GENERATED, do not edit by hand)
Event
| where (((CommandLine contains @"net stop " or CommandLine contains @"sc stop " or CommandLine contains @"Stop-Service")) and ((CommandLine contains @"sql" or CommandLine contains @"veeam" or CommandLine contains @"backup" or CommandLine contains @"exchange" or CommandLine contains @"vss" or CommandLine contains @"msexchange")))
| summarize Hits=count() by bin(TimeGenerated, 5m), host
| where Hits >= 3
