// Entra ID Password Spray From One IP
// Detects one source IP failing sign-in with a wrong password (error 50126) against many distinct Entra ID accounts in a short window.
// techniques: T1110.003   severity: high   status: experimental
// validate: Atomic Red Team T1110.003
//   Spray one wrong password across 10+ lab tenant accounts from one IP,
//   e.g. with MSOLSpray or Invoke-AzureAdPasswordSprayAttack.
// source: rules/credential-access/entra-password-spray.yml  (GENERATED, do not edit by hand)
SigninLogs
| where ((ResultType =~ @"50126"))
| summarize Hits=dcount(UserPrincipalName) by bin(TimeGenerated, 10m), IPAddress
| where Hits >= 10
