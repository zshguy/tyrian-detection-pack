<!-- Possible DNS Tunneling via Abnormally Long Queries  [rules/command-and-control/dns-tunneling-long-query.yml] -->
<group name="sysmon,">
  <rule id="100100" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.eventID">^22$</field>
    <field name="win.eventdata.queryName">^[A-Za-z0-9+/=_-]{40,}\\.</field>
    <frequency>10</frequency>
    <timeframe>300</timeframe>
    <same_field>host</same_field>
    <description>Possible DNS Tunneling via Abnormally Long Queries</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <options>no_full_log</options>
  </rule>
</group>

